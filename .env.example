# PrepForge AI Environment Configuration Example

# Primary Generative AI Provider (OpenAI GPT-5.6 by default)
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Secondary Provider
GEMINI_API_KEY=your-gemini-api-key-here

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=prepforge_ai

# FAISS Vector Storage
FAISS_INDEX_PATH=./data/faiss_index

# Coding Interview Execution Engine (Judge0)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-judge0-key-here

# Operating Mode
DEMO_MODE=false
